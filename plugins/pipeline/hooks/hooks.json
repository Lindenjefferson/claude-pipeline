{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-secret-scan.py\"",
            "if": "Bash(git *)",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Scanning staged diff for secrets..."
          }
        ]
      }
    ]
  }
}
