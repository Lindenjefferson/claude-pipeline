{
  "core": [
    "Bash(npm ci)",
    "Bash(npm install)"
  ],
  "nextjs": [
    "Bash(npx next info)"
  ],
  "supabase": [
    "Bash(npx supabase status)",
    "Bash(npx supabase start)",
    "Bash(npx supabase stop)",
    "Bash(npx supabase db reset)",
    "Bash(npx supabase test db)",
    "Bash(npx supabase migration new:*)",
    "Bash(npx supabase migration list --local)"
  ],
  "script_name_globs": {
    "core": ["lint", "lint:*", "typecheck", "typecheck:*", "test", "test:*", "build"],
    "nextjs": ["dev", "e2e:smoke"],
    "supabase": ["db:*"]
  },
  "script_entry": "Bash(npm run <script>)",
  "deny": [
    "Edit(.pipeline-secrets-allow)",
    "Write(.pipeline-secrets-allow)",
    "Bash(git commit --no-verify:*)",
    "Bash(git commit -n:*)"
  ],
  "never_allow": [
    "db push",
    "db dump",
    "--linked",
    "--db-url",
    "link",
    "migration repair",
    "secrets set",
    "deploy",
    "vercel",
    "git push",
    "rm -rf"
  ]
}
