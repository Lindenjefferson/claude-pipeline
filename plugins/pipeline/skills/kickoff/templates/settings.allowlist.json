{
  "entry": "Bash(<command>)",
  "deny": [
    "Edit(.pipeline-secrets-allow)",
    "Write(.pipeline-secrets-allow)",
    "Bash(git commit --no-verify:*)",
    "Bash(git commit -n:*)",
    "Bash(sudo:*)",
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(chmod 777:*)"
  ],
  "never_allow": [
    "db push",
    "db dump",
    "--linked",
    "--db-url",
    "link",
    "migration repair",
    "secrets set",
    "deploy",
    "publish",
    "vercel",
    "git push",
    "rm -rf",
    "sudo",
    "--force",
    "chmod 777",
    "| sh",
    "| bash"
  ]
}
