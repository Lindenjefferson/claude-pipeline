{
  "entry": "Bash(<command>)",
  "deny": [
    "Edit(.pipeline-secrets-allow)",
    "Bash(git commit *--no-verify*)",
    "Bash(git commit -n *)",
    "Bash(git commit * -n *)",
    "Bash(git -c core.hooksPath*)",
    "Bash(sudo:*)",
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(chmod 777:*)"
  ],
  "ask": [
    "Bash(git push:*)"
  ],
  "never_allow": [
    "deploy",
    "publish",
    "git push",
    "rm -rf",
    "sudo",
    "--force",
    "chmod 777",
    "| sh",
    "| bash"
  ]
}
